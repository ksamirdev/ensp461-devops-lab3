textstats_words_processed_total 1392.0

$ curl -s http://localhost:9390/api/v1/targets | jq -r '.data.activeTargets[] | "\(.labels.job) \(.scrapeUrl) \(.health)"'
prometheus http://localhost:9090/metrics up
text-stats http://app:5000/metrics up

