$ cat observability/prometheus.yml
global:
  scrape_interval: 5s

scrape_configs:
  - job_name: text-stats
    static_configs:
      - targets: ["app:5000"]
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

$ docker compose -f observability/compose.yml up -d --build app prometheus grafana 2>&1 | grep -E 'Started|Running|Healthy|Built'
