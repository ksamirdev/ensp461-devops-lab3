$ cat observability/logstash/pipeline.conf
input {
  file {
    path => "/var/log/text-stats/app.log"
    start_position => "beginning"
    sincedb_path => "/dev/null"
  }
}

filter {
  grok {
    match => {
      "message" => "%{TIMESTAMP_ISO8601:logged_at} %{LOGLEVEL:level} %{WORD:logger} method=%{WORD:method} path=%{NOTSPACE:route} status=%{NUMBER:status:int} duration_ms=%{NUMBER:duration_ms:float}"
    }
  }
  date {
    match => ["logged_at", "yyyy-MM-dd HH:mm:ss,SSS"]
    timezone => "UTC"
    remove_field => ["logged_at"]
  }
}

output {
  elasticsearch {
    hosts => ["http://elasticsearch:9200"]
    index => "text-stats-logs"
  }
}

$ docker compose -f observability/compose.yml up -d elasticsearch logstash kibana 2>&1 | grep -E 'Started|Running|Healthy'
